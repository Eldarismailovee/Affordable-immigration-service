PORT=5000
CLIENT_URL=http://127.0.0.1:5173
DATABASE_URL=postgresql://arina@127.0.0.1:5432/immigration_firm
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_SECONDS=0
DB_POOL_MAX_USES=0
DB_POOL_ALLOW_EXIT_ON_IDLE=false
DB_APPLICATION_NAME=affordable-immigration-service
DB_SLOW_QUERY_MS=250
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
UPLOAD_STORAGE_DRIVER=local
UPLOAD_VIRUS_SCAN_ENABLED=false
UPLOAD_VIRUS_SCAN_COMMAND=clamdscan
UPLOAD_VIRUS_SCAN_TIMEOUT_MS=10000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=System Administrator
# Log retention (days): technical/operational DB rows & infra log rotation target
TECHNICAL_LOG_RETENTION_DAYS=90
# Security audit tables (audit_events, admin_audit_log); 365 recommended when handling payments
SECURITY_AUDIT_RETENTION_DAYS=365
