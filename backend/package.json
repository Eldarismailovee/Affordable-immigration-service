{
  "name": "immigration-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:check": "node src/db/migrate.js --check",
    "retention:purge": "node src/scripts/runRetentionJobs.js",
    "retention:run": "node src/scripts/runRetentionJobs.js",
    "create-initial-admin": "node scripts/create-initial-admin.js",
    "start": "node src/server.js",
    "test": "NODE_ENV=test node --test --experimental-test-module-mocks --test-reporter=spec \"tests/**/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "multer": "^2.2.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer-core": "^25.9.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
