PORT=5000
CLIENT_URL=https://yourdomain.com
BASE_URL=https://api.yourdomain.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_SECONDS=1800
DB_POOL_MAX_USES=10000
DB_POOL_ALLOW_EXIT_ON_IDLE=false
DB_APPLICATION_NAME=affordable-immigration-service
DB_SLOW_QUERY_MS=250
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
CHROMIUM_PATH=/usr/bin/chromium
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
UPLOAD_STORAGE_DRIVER=local
UPLOAD_VIRUS_SCAN_ENABLED=true
UPLOAD_VIRUS_SCAN_COMMAND=clamdscan
UPLOAD_VIRUS_SCAN_TIMEOUT_MS=10000
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password
ADMIN_NAME=System Administrator
# Required in production for encrypted DSAR export PDFs on disk (32-byte key, base64)
DOCUMENT_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
