POSTGRES_DB=immigration_firm
POSTGRES_USER=immigration
POSTGRES_PASSWORD=change-me

PORT=5000
CLIENT_URL=http://127.0.0.1
BASE_URL=http://127.0.0.1
DATABASE_URL=postgresql://immigration:change-me@postgres:5432/immigration_firm
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_SECONDS=0
DB_POOL_MAX_USES=0
DB_POOL_ALLOW_EXIT_ON_IDLE=false
DB_APPLICATION_NAME=affordable-immigration-service
DB_SLOW_QUERY_MS=250
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
CHROMIUM_PATH=/usr/bin/chromium
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=info
# Optional comma-separated origins; defaults to CLIENT_URL in production
# CORS_ORIGINS=
# Optional comma-separated payment redirect host allowlist
# PAYMENT_HOST_ALLOWLIST=
UPLOAD_STORAGE_DRIVER=local
UPLOAD_VIRUS_SCAN_ENABLED=false
UPLOAD_VIRUS_SCAN_COMMAND=clamdscan
UPLOAD_VIRUS_SCAN_TIMEOUT_MS=10000
TECHNICAL_LOG_RETENTION_DAYS=90
SECURITY_AUDIT_RETENTION_DAYS=365
# Optional: 32-byte AES-256 key, base64-encoded (encrypts DSAR export PDFs on disk)
# DOCUMENT_ENCRYPTION_KEY_BASE64=

# MFA (required in production): 32-byte key, base64-encoded
# Generate: openssl rand -base64 32
# MFA_ENCRYPTION_KEY=
# MFA_ENCRYPTION_KEY_VERSION=v1
# MFA_ISSUER=Affordable Immigration Service
# MFA_CHALLENGE_TTL_SECONDS=300
# MFA_STEP_UP_MAX_AGE_SECONDS=300
# MFA_MAX_ATTEMPTS=5

APP_PUBLIC_URL=http://127.0.0.1:5173
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=3600
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5
EMAIL_VERIFICATION_MAX_VERIFY_ATTEMPTS=5

# Idempotency (required in production when keyed hash is enabled)
# Generate: openssl rand -hex 32
# IDEMPOTENCY_KEY_HMAC_SECRET=
IDEMPOTENCY_DEFAULT_TTL_SECONDS=86400
IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS=300
IDEMPOTENCY_MAX_KEY_LENGTH=128
IDEMPOTENCY_MAX_RESPONSE_BYTES=65536
# IDEMPOTENCY_CLEANUP_BATCH_SIZE=500

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=System Administrator

VITE_API_URL=/api

